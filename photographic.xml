<theme>

  <!-- System -->
  <view name="system">
    <carousel name="systemcarousel">
      <type>horizontalWheel</type>
      <pos>-.027 -.15</pos>
      <origin>0.0 0.0</origin>
      <size>0.6 1.0</size>
      <itemScale>1.2</itemScale>
      <itemsBeforeCenter>0</itemsBeforeCenter>
      <itemsAfterCenter>0</itemsAfterCenter>
      <fastScrolling>true</fastScrolling>
      <staticImage>./_inc/sysicons/${system.theme}.png</staticImage>
      <defaultImage>./_inc/sysicons/default.png</defaultImage>
      <color>00000000</color>
      <zIndex>3</zIndex>
    </carousel>

    <image name="background">
      <path>${tv}bg.png</path>
      <tile>false</tile>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>0</zIndex>
    </image>
    <image name="background2">
      <path>${tv}bg2.png</path>
      <tile>false</tile>
      <pos>0 0</pos>
      <origin>0 0</origin>
      <size>1 1</size>
      <zIndex>6</zIndex>
    </image>

    <animation name="caramel">
      <zIndex>2</zIndex>
      <path>./_inc/grafx/tv/lights.gif</path>
      <pos>0 .1</pos>
      <origin>0 0</origin>
      <size>.5 .5></size>
      <speed>.65</speed>
      <opacity>.2</opacity>
    </animation>

    <image name="syslogo">
      <pos>.275 .835</pos>
      <origin>0.5 0.5</origin>
      <maxSize>.4 .2</maxSize>
      <path>./_inc/logo/${system.theme}.svg</path>
      <visible>true</visible>
      <zIndex>6></zIndex>
    </image>

    <text name="sysbackup">
      <pos>.25 .15</pos>
      <origin>0.5 0.5</origin>
      <size>w 0</size>
      <fontSize>.07</fontSize>
      <rotation>-2</rotation>
      <color>000000FF</color>
      <fontPath>.\_inc\fonts\AGENCYR.TTF</fontPath>
      <systemdata>name</systemdata>
      <visible>!${syslogo}</visible>
      <zIndex>6></zIndex>
    </text>

    <image name="sysbackuppaper">
      <pos>.25 .15</pos>
      <origin>0.5 0.5</origin>
      <maxSize>.5 .5</maxSize>
      <rotation>-2</rotation>
      <path>./_inc/grafx/paper.png</path>
      <visible>!${syslogo}</visible>
      <zIndex>3></zIndex>
    </image>

    <image name="pub">
      <pos>.75 .5</pos>
      <origin>0.5 0.5</origin>
      <maxSize>.9 .9</maxSize>
      <path>./_inc/pubs/${system.theme}.png</path>
      <zIndex>15></zIndex>
    </image>



  </view>

  <!-- Gamelist -->

  <!-- Aspect Ratios -->
  <aspectRatio name="21:9">
    <include>./21-9.xml</include>
  </aspectRatio>

  <aspectRatio name="16:10">
    <include>./16-10.xml</include>
  </aspectRatio>

  <aspectRatio name="16:9">
    <include>./16-9.xml</include>
  </aspectRatio>

  <aspectRatio name="1:1">
    <include>./1-1.xml</include>
  </aspectRatio>

</theme>
