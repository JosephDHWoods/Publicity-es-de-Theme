<theme>
  <view name="system">  
    <image name="background">
      <path>${steamdeck}bg.png</path>
    </image>

    <image name="background1">
      <path>${steamdeck}bg1.png</path>
    </image>

    <image name="background2">
      <path>${steamdeck}bg2.png</path>
    </image>

    <carousel name="systemcarousel">
    </carousel>

    <image name="sysphoto">
      <pos>.3 .35</pos>
      <maxSize>.25 .3</maxSize>
    </image>

    <image name="syslogo">
      <pos>.3 .833</pos>
      <maxSize>.45 .23</maxSize>
    </image>

    <image name="pub">
      <pos>.77 .5</pos>
      <maxSize>.4 .9</maxSize>
    </image>

    <helpsystem name="help">
      <pos>0.1 0.01</pos>
      <origin>0 0</origin>
    </helpsystem>

  </view>
</theme>